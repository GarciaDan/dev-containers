{
  "name": "playwright-ts",
  "version": "1.0.0",
  "description": "Scaffold for Playwright with TypeScript",
  "main": "src/app.ts",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "pnpm install && pnpm exec playwright install --with-deps",
    "start": "ts-node src/app.ts",
    "build": "tsc",
    "dev": "ts-node src/app.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "scaffold",
    "automation",
    "testing",
    "devcontainer"
  ],
  "author": "Daniel Garcia <dev@danigarcia.org>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "html-to-text": "^9.0.5",
    "pino": "^10.1.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
